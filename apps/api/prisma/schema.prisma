// ========================================================
// bodo ERP - Database Schema (Single Company Database)
// Step S1.2: Base schema with strict UTC timestamps and UUIDv7
// ========================================================

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────── Enums ─────────────

enum UserType {
  INTERNAL
  PORTAL
}

enum UserStatus {
  ACTIVE
  DISABLED
  LOCKED
}

enum RuleScope {
  OWN
  TEAM
  ALL
  CUSTOM
}

enum EventSource {
  UI
  API
  IMPORT
  SYSTEM
}

enum LostAppliesTo {
  LEAD
  QUOTATION
  BOTH
}

// ───────────── Company Profile ─────────────

// Exactly one row (id = 1, enforced by DB CHECK). Initially empty, configured in settings.
model CompanyProfile {
  id                  Int      @id @default(1)
  name                String   @default("")
  legalName           String?  @map("legal_name")
  nationalId          String?  @map("national_id")
  registrationNo      String?  @map("registration_no")
  economicCode        String?  @map("economic_code")
  phone               String?
  email               String?
  website             String?
  address             String?
  postalCode                String?  @map("postal_code")
  logoFileId                String?  @map("logo_file_id") @db.Uuid
  logoUrl                   String?  @map("logo_url")
  bankName                  String?  @map("bank_name")
  accountNumber             String?  @map("account_number")
  iban                      String?
  defaultTaxRate            Decimal  @default(10) @map("default_tax_rate") @db.Decimal(5, 2)
  defaultQuoteValidityDays  Int      @default(1) @map("default_quote_validity_days")
  termsAndConditions        String?  @map("terms_and_conditions")
  defaultCurrencyCode       String   @default("IRR") @map("default_currency_code")
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedById         String?  @map("updated_by_id") @db.Uuid

  defaultCurrency Currency @relation(fields: [defaultCurrencyCode], references: [code])

  @@map("company_profile")
}

// Currencies: No internal exchange rates are stored
model Currency {
  code      String  @id // IRR, IRT, USD, EUR
  name      String
  symbol    String
  decimals  Int     @default(0)
  isActive  Boolean @default(true) @map("is_active")
  sortOrder Int     @default(0) @map("sort_order")

  profiles CompanyProfile[]

  @@map("currencies")
}

// Database-level key-value settings (e.g. neutralized)
model SystemSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("system_settings")
}

// ───────────── Users & Sessions ─────────────

model User {
  id                 String     @id @db.Uuid
  type               UserType   @default(INTERNAL)
  username           String     @unique
  passwordHash       String     @map("password_hash") // argon2id
  fullName           String     @map("full_name")
  mobile             String?    @unique // Normalized +98...
  email              String?    @unique
  avatarFileId       String?    @map("avatar_file_id") @db.Uuid
  status             UserStatus @default(ACTIVE)
  mustChangePassword Boolean    @default(false) @map("must_change_password")
  failedLoginCount   Int        @default(0) @map("failed_login_count")
  lockedUntil        DateTime?  @map("locked_until") @db.Timestamptz(3)
  lastLoginAt        DateTime?  @map("last_login_at") @db.Timestamptz(3)
  passwordChangedAt  DateTime?  @map("password_changed_at") @db.Timestamptz(3)
  portalContactId    String?    @map("portal_contact_id") @db.Uuid
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt          DateTime?  @map("deleted_at") @db.Timestamptz(3)

  groupMembers GroupMember[]
  teamMembers  TeamMember[]
  sessions     Session[]

  @@index([type, status])
  @@map("users")
}

model Session {
  id               String    @id @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @unique @map("refresh_token_hash")
  familyId         String    @map("family_id") @db.Uuid
  familyCreatedAt  DateTime  @default(now()) @map("family_created_at") @db.Timestamptz(3)
  userAgent        String?   @map("user_agent")
  ip               String?
  lastIp           String?   @map("last_ip")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt       DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(3)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(3)
  rotatedAt        DateTime? @map("rotated_at") @db.Timestamptz(3)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokedReason    String?   @map("revoked_reason")

  user User @relation(fields: [userId], references: [id])

  @@index([userId, revokedAt])
  @@index([familyId])
  @@index([familyId, rotatedAt])
  @@map("sessions")
}

// ───────────── Groups, Teams, Permissions ─────────────

model Group {
  id          String   @id @db.Uuid
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById String?  @map("created_by_id") @db.Uuid
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedById String?  @map("updated_by_id") @db.Uuid

  members     GroupMember[]
  permissions GroupPermission[]
  recordRules RecordRule[]

  @@map("groups")
}

model GroupMember {
  groupId String @map("group_id") @db.Uuid
  userId  String @map("user_id") @db.Uuid

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id])

  @@id([groupId, userId])
  @@map("group_members")
}

model GroupPermission {
  groupId        String @map("group_id") @db.Uuid
  permissionCode String @map("permission_code")

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([groupId, permissionCode])
  @@map("group_permissions")
}

model Team {
  id        String   @id @db.Uuid
  name      String   @unique
  leaderId  String?  @map("leader_id") @db.Uuid
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  members TeamMember[]

  @@map("teams")
}

model TeamMember {
  teamId String @map("team_id") @db.Uuid
  userId String @map("user_id") @db.Uuid

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@id([teamId, userId])
  @@map("team_members")
}

model RecordRule {
  id           String    @id @db.Uuid
  groupId      String    @map("group_id") @db.Uuid
  resource     String
  canRead      Boolean   @default(true) @map("can_read")
  canWrite     Boolean   @default(true) @map("can_write")
  canCreate    Boolean   @default(true) @map("can_create")
  canDelete    Boolean   @default(false) @map("can_delete")
  scope        RuleScope @default(OWN)
  ownerField   String    @default("ownerId") @map("owner_field")
  customFilter Json?     @map("custom_filter")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, resource])
  @@map("record_rules")
}

// ───────────── Audit & Timeline (Partitioned) ─────────────

model AuditLog {
  id         String      @db.Uuid
  occurredAt DateTime    @default(now()) @map("occurred_at") @db.Timestamptz(3)
  actorId    String?     @map("actor_id") @db.Uuid
  source     EventSource @default(UI)
  action     String
  entityType String      @map("entity_type")
  entityId   String?     @map("entity_id") @db.Uuid
  changes    Json?
  meta       Json?
  requestId  String?     @map("request_id")

  @@id([id, occurredAt])
  @@index([entityType, entityId, occurredAt(sort: Desc)])
  @@index([actorId, occurredAt(sort: Desc)])
  @@map("audit_logs")
}

model TimelineEvent {
  id            String      @db.Uuid
  occurredAt    DateTime    @map("occurred_at") @db.Timestamptz(3)
  subjectType   String      @map("subject_type")
  subjectId     String      @map("subject_id") @db.Uuid
  eventType     String      @map("event_type")
  actorId       String?     @map("actor_id") @db.Uuid
  source        EventSource @default(SYSTEM)
  refType       String?     @map("ref_type")
  refId         String?     @map("ref_id") @db.Uuid
  title         String
  summary       String?
  role          String?
  meta          Json?
  sourceEventId String?     @map("source_event_id") @db.Uuid

  @@id([id, occurredAt])
  @@index([subjectType, subjectId, occurredAt(sort: Desc)])
  @@index([refType, refId])
  @@unique([sourceEventId, subjectType, subjectId, occurredAt], map: "timeline_events_source_event_id_subject_type_subject_id_occ_key")
  @@map("timeline_events")
}

model OutboxEvent {
  id          String    @id @db.Uuid
  type        String
  payload     Json
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  processedAt DateTime? @map("processed_at") @db.Timestamptz(3)
  attempts    Int       @default(0)
  lastError   String?   @map("last_error")

  @@index([processedAt, createdAt])
  @@map("outbox_events")
}

// ───────────── Sequences ─────────────

model Sequence {
  id           String   @id @db.Uuid
  code         String   @unique
  prefix       String   @default("")
  pattern      String   @default("{prefix}{yyyy}-{seq:5}")
  nextValue    BigInt   @default(1) @map("next_value")
  resetPolicy  String   @default("YEARLY") @map("reset_policy")
  lastResetKey String?  @map("last_reset_key")
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("sequences")
}

// ───────────── Settings: Lost Reasons ─────────────

model LostReason {
  id          String        @id @db.Uuid
  name        String        @unique
  appliesTo   LostAppliesTo @default(BOTH) @map("applies_to")
  sortOrder   Int           @default(0) @map("sort_order")
  isActive    Boolean       @default(true) @map("is_active")
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById String?       @map("created_by_id") @db.Uuid
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedById String?       @map("updated_by_id") @db.Uuid

  @@map("lost_reasons")
}

// ───────────── Business Core: Contacts, Products, Sales ─────────────

enum ContactType {
  CUSTOMER
  SUPPLIER
  TRANSPORTER
  PARTNER
}

enum ProductCategoryType {
  REBAR
  BEAM
  SHEET
  PROFILE
  PIPE
  WIRE
  OTHER
}

enum ProductType {
  STORABLE
  CONSUMABLE
  SERVICE
}

enum InvoicingPolicy {
  ORDERED
  DELIVERED
}

enum UomType {
  REFERENCE
  BIGGER
  SMALLER
}

enum SaleOrderStage {
  DRAFT
  SENT
  CONFIRMED
  LOST
  CANCELLED
}

model Contact {
  id               String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type             ContactType @default(CUSTOMER)
  name             String
  companyName      String?     @map("company_name")
  nationalId       String?     @map("national_id")
  economicCode     String?     @map("economic_code")
  phone            String?
  mobile           String?
  email            String?
  city             String?
  address          String?
  balanceToman     Decimal     @default(0) @map("balance_toman") @db.Decimal(18, 0)
  creditLimitToman Decimal     @default(0) @map("credit_limit_toman") @db.Decimal(18, 0)
  isActive         Boolean     @default(true) @map("is_active")
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt        DateTime?   @map("deleted_at") @db.Timestamptz(3)

  saleOrders       SaleOrder[]
  supplierInfos    SupplierInfo[]
  purchaseOrders   PurchaseOrder[]
  crmLeads         CrmLead[]
  weighbridgeSlips WeighbridgeSlip[]

  @@index([type, isActive])
  @@index([name])
  @@index([mobile])
  @@map("contacts")
}

model UomCategory {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  uoms Uom[]

  @@map("uom_categories")
}

model Uom {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoryId  String      @map("category_id") @db.Uuid
  name        String
  uomType     UomType     @default(REFERENCE) @map("uom_type")
  factor      Decimal     @default(1) @db.Decimal(12, 6)
  rounding    Decimal     @default(0.001) @db.Decimal(12, 6)
  isActive    Boolean     @default(true) @map("is_active")
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  category               UomCategory       @relation(fields: [categoryId], references: [id])
  templatesAsUom         ProductTemplate[] @relation("TemplateUom")
  templatesAsPurchaseUom ProductTemplate[] @relation("TemplatePurchaseUom")

  @@unique([categoryId, name])
  @@map("uoms")
}

model ProductCategory {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  parentId  String?   @map("parent_id") @db.Uuid
  fullPath  String    @default("") @map("full_path")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  parent    ProductCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children  ProductCategory[] @relation("CategoryHierarchy")
  templates ProductTemplate[]

  @@map("product_categories")
}

model ProductAttribute {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @unique
  displayType String   @default("radio") @map("display_type")
  sequence    Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  values ProductAttributeValue[]

  @@map("product_attributes")
}

model ProductAttributeValue {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  attributeId String   @map("attribute_id") @db.Uuid
  name        String
  sequence    Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  attribute     ProductAttribute               @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  variantValues ProductVariantAttributeValue[]

  @@unique([attributeId, name])
  @@map("product_attribute_values")
}

model ProductTemplate {
  id                  String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                String
  type                ProductType     @default(STORABLE)
  invoicingPolicy     InvoicingPolicy @default(ORDERED) @map("invoicing_policy")
  categoryId          String?         @map("category_id") @db.Uuid
  defaultCode         String?         @map("default_code")
  barcode             String?
  salesPriceToman     Decimal         @default(0) @map("sales_price_toman") @db.Decimal(18, 0)
  costPriceToman      Decimal         @default(0) @map("cost_price_toman") @db.Decimal(18, 0)
  uomId               String?         @map("uom_id") @db.Uuid
  purchaseUomId       String?         @map("purchase_uom_id") @db.Uuid
  canBeSold           Boolean         @default(true) @map("can_be_sold")
  canBePurchased      Boolean         @default(true) @map("can_be_purchased")
  descriptionSale     String?         @map("description_sale")
  descriptionPurchase String?         @map("description_purchase")
  internalNotes       String?         @map("internal_notes")
  weightKg            Decimal?        @map("weight_kg") @db.Decimal(12, 3)
  isActive            Boolean         @default(true) @map("is_active")
  createdAt           DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt           DateTime?       @map("deleted_at") @db.Timestamptz(3)

  category      ProductCategory? @relation(fields: [categoryId], references: [id])
  uom           Uom?             @relation("TemplateUom", fields: [uomId], references: [id])
  purchaseUom   Uom?             @relation("TemplatePurchaseUom", fields: [purchaseUomId], references: [id])
  variants      Product[]
  supplierInfos SupplierInfo[]

  @@index([name])
  @@index([defaultCode])
  @@map("product_templates")
}

model Product {
  id              String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  templateId      String?             @map("template_id") @db.Uuid
  code            String              @unique
  name            String
  category        ProductCategoryType @default(REBAR)
  mill            String              @default("") // کارخانه سازنده
  standard        String              @default("") // استاندارد (A3, St37, IPE)
  size            String              @default("") // سایز یا ضخامت
  defaultUnit     String              @default("کیلوگرم") @map("default_unit")
  allowedUnits    Json                @default("[\"کیلوگرم\", \"شاخه\", \"بندل\"]") @map("allowed_units")
  pricePerKgToman Decimal             @default(0) @map("price_per_kg_toman") @db.Decimal(18, 0)
  priceExtraToman Decimal             @default(0) @map("price_extra_toman") @db.Decimal(18, 0)
  stockKg         Decimal             @default(0) @map("stock_kg") @db.Decimal(18, 3)
  forecastedKg    Decimal             @default(0) @map("forecasted_kg") @db.Decimal(18, 3)
  soldQtyKg       Decimal             @default(0) @map("sold_qty_kg") @db.Decimal(18, 3)
  purchasedQtyKg  Decimal             @default(0) @map("purchased_qty_kg") @db.Decimal(18, 3)
  barcode         String?
  isActive        Boolean             @default(true) @map("is_active")
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt       DateTime?           @map("deleted_at") @db.Timestamptz(3)

  template             ProductTemplate?               @relation(fields: [templateId], references: [id], onDelete: Cascade)
  attributeValues      ProductVariantAttributeValue[]
  supplierInfos        SupplierInfo[]
  orderLines           SaleOrderLine[]
  purchaseOrderLines   PurchaseOrderLine[]
  sourcingInquiryLines SourcingInquiryLine[]
  dailyPrices          DailyPrice[]

  @@index([category, isActive])
  @@index([mill])
  @@map("products")
}

model ProductVariantAttributeValue {
  variantId        String @map("variant_id") @db.Uuid
  attributeValueId String @map("attribute_value_id") @db.Uuid

  variant        Product               @relation(fields: [variantId], references: [id], onDelete: Cascade)
  attributeValue ProductAttributeValue @relation(fields: [attributeValueId], references: [id], onDelete: Cascade)

  @@id([variantId, attributeValueId])
  @@map("product_variant_attribute_values")
}

model SupplierInfo {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  templateId        String?  @map("template_id") @db.Uuid
  variantId         String?  @map("variant_id") @db.Uuid
  vendorId          String   @map("vendor_id") @db.Uuid
  vendorName        String   @map("vendor_name")
  vendorProductCode String?  @map("vendor_product_code")
  vendorProductName String?  @map("vendor_product_name")
  minQuantity       Decimal  @default(1) @map("min_quantity") @db.Decimal(18, 3)
  priceToman        Decimal  @default(0) @map("price_toman") @db.Decimal(18, 0)
  currency          String   @default("TOMAN")
  leadTimeDays      Int      @default(1) @map("lead_time_days")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  template ProductTemplate? @relation(fields: [templateId], references: [id], onDelete: Cascade)
  variant  Product?         @relation(fields: [variantId], references: [id], onDelete: Cascade)
  vendor   Contact          @relation(fields: [vendorId], references: [id])

  @@index([vendorId])
  @@map("product_supplier_info")
}

model SaleOrder {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  quotationNo     String         @unique @map("quotation_no")
  orderNo         String?        @unique @map("order_no")
  customerId      String         @map("customer_id") @db.Uuid
  customerName    String         @map("customer_name")
  stage           SaleOrderStage @default(DRAFT)
  date            DateTime       @default(now()) @db.Timestamptz(3)
  expiryDate      DateTime?      @map("expiry_date") @db.Timestamptz(3)
  salespersonId   String?        @map("salesperson_id") @db.Uuid
  salespersonName String?        @map("salesperson_name")
  subtotalToman   Decimal        @default(0) @map("subtotal_toman") @db.Decimal(18, 0)
  taxToman        Decimal        @default(0) @map("tax_toman") @db.Decimal(18, 0)
  freightToman    Decimal        @default(0) @map("freight_toman") @db.Decimal(18, 0)
  grandTotalToman Decimal        @default(0) @map("grand_total_toman") @db.Decimal(18, 0)
  totalWeightKg   Decimal        @default(0) @map("total_weight_kg") @db.Decimal(18, 3)
  shippingAddress String?        @map("shipping_address")
  portalToken     String?        @unique @default(dbgenerated("gen_random_uuid()")) @map("portal_token")
  lostReasonId    String?        @map("lost_reason_id") @db.Uuid
  lostNotes       String?        @map("lost_notes")
  notes           String?
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt       DateTime?      @map("deleted_at") @db.Timestamptz(3)

  customer         Contact           @relation(fields: [customerId], references: [id])
  lines            SaleOrderLine[]
  crmLeads         CrmLead[]
  weighbridgeSlips WeighbridgeSlip[]

  @@index([stage, date(sort: Desc)])
  @@index([customerId])
  @@index([portalToken])
  @@map("sale_orders")
}

model SaleOrderLine {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId         String    @map("order_id") @db.Uuid
  productId       String?   @map("product_id") @db.Uuid
  productName     String    @map("product_name")
  mill            String    @default("")
  unit            String    @default("کیلوگرم")
  quantity        Decimal   @default(0) @db.Decimal(18, 3)
  unitPriceToman    Decimal                  @default(0) @map("unit_price_toman") @db.Decimal(18, 0)
  taxPercent        Decimal                  @default(10) @map("tax_percent") @db.Decimal(5, 2)
  totalPriceToman   Decimal                  @default(0) @map("total_price_toman") @db.Decimal(18, 0)
  allocatedQuantity Decimal                  @default(0) @map("allocated_quantity") @db.Decimal(18, 3)
  createdAt         DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)

  order       SaleOrder                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product?                 @relation(fields: [productId], references: [id])
  allocations PurchaseSaleAllocation[]

  @@index([orderId])
  @@map("sale_order_lines")
}

// ───────────── Sourcing, Purchases & Allocation (Odoo 17 Inspired) ─────────────

enum PurchaseOrderStage {
  RFQ
  RFQ_SENT
  PURCHASE_ORDER
  DONE
  CANCELLED
}

enum AllocationStatus {
  COMMITTED
  FULFILLED
  RELEASED
}

model PurchaseOrder {
  id              String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderNo         String             @unique @map("order_no") // PO-1403-XXXX or RFQ-1403-XXXX
  vendorId        String             @map("vendor_id") @db.Uuid
  vendorName      String             @map("vendor_name")
  stage           PurchaseOrderStage @default(RFQ)
  date            DateTime           @default(now()) @db.Timestamptz(3)
  deliveryDate    DateTime?          @map("delivery_date") @db.Timestamptz(3)
  buyerId         String?            @map("buyer_id") @db.Uuid
  buyerName       String?            @map("buyer_name")
  subtotalToman   Decimal            @default(0) @map("subtotal_toman") @db.Decimal(18, 0)
  taxToman        Decimal            @default(0) @map("tax_toman") @db.Decimal(18, 0)
  grandTotalToman Decimal            @default(0) @map("grand_total_toman") @db.Decimal(18, 0)
  inquiryId       String?            @map("inquiry_id") @db.Uuid
  notes           String?
  version         Int                @default(1)
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt       DateTime?          @map("deleted_at") @db.Timestamptz(3)

  vendor  Contact             @relation(fields: [vendorId], references: [id])
  inquiry SourcingInquiry?    @relation(fields: [inquiryId], references: [id], onDelete: SetNull)
  lines   PurchaseOrderLine[]

  @@index([stage, date(sort: Desc)])
  @@index([vendorId])
  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId           String   @map("order_id") @db.Uuid
  productId         String?  @map("product_id") @db.Uuid
  productName       String   @map("product_name")
  mill              String   @default("")
  unit              String   @default("کیلوگرم")
  quantity          Decimal  @default(0) @db.Decimal(18, 3)
  unitPriceToman    Decimal  @default(0) @map("unit_price_toman") @db.Decimal(18, 0)
  taxPercent        Decimal  @default(10) @map("tax_percent") @db.Decimal(5, 2)
  totalPriceToman   Decimal  @default(0) @map("total_price_toman") @db.Decimal(18, 0)
  allocatedQuantity Decimal  @default(0) @map("allocated_quantity") @db.Decimal(18, 3)
  receivedQuantity  Decimal  @default(0) @map("received_quantity") @db.Decimal(18, 3)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  order       PurchaseOrder            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product?                 @relation(fields: [productId], references: [id])
  allocations PurchaseSaleAllocation[]

  @@index([orderId])
  @@map("purchase_order_lines")
}

model PurchaseSaleAllocation {
  id                  String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  saleOrderLineId     String           @map("sale_order_line_id") @db.Uuid
  purchaseOrderLineId String           @map("purchase_order_line_id") @db.Uuid
  allocatedQuantity   Decimal          @map("allocated_quantity") @db.Decimal(18, 3)
  status              AllocationStatus @default(COMMITTED)
  notes               String?
  version             Int              @default(1)
  createdAt           DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  saleOrderLine     SaleOrderLine     @relation(fields: [saleOrderLineId], references: [id], onDelete: Cascade)
  purchaseOrderLine PurchaseOrderLine @relation(fields: [purchaseOrderLineId], references: [id], onDelete: Cascade)

  @@index([saleOrderLineId])
  @@index([purchaseOrderLineId])
  @@map("purchase_sale_allocations")
}

model SourcingInquiry {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  inquiryNo   String    @unique @map("inquiry_no") // INQ-1403-XXXX
  title       String
  stage       String    @default("OPEN") // OPEN, OFFERS_RECEIVED, CLOSED, CANCELLED
  saleOrderId String?   @map("sale_order_id") @db.Uuid
  notes       String?
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)

  lines  SourcingInquiryLine[]
  orders PurchaseOrder[]

  @@index([stage])
  @@map("sourcing_inquiries")
}

model SourcingInquiryLine {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  inquiryId        String   @map("inquiry_id") @db.Uuid
  productId        String?  @map("product_id") @db.Uuid
  productName      String   @map("product_name")
  mill             String   @default("")
  quantity         Decimal  @default(0) @db.Decimal(18, 3)
  unit             String   @default("کیلوگرم")
  targetPriceToman Decimal? @map("target_price_toman") @db.Decimal(18, 0)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  inquiry SourcingInquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  product Product?        @relation(fields: [productId], references: [id])

  @@index([inquiryId])
  @@map("sourcing_inquiry_lines")
}

// ───────────── CRM Pipeline & Daily Pricing ─────────────

enum CrmStage {
  NEW
  CONTACTED
  NEEDS_ANALYSIS
  QUOTED
  NEGOTIATION
  WON
  LOST
}

model CrmLead {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title                String
  contactId            String?   @map("contact_id") @db.Uuid
  contactName          String    @map("contact_name")
  contactPhone         String?   @map("contact_phone")
  stage                CrmStage  @default(NEW)
  priority             Int       @default(1)
  expectedRevenueToman Decimal   @default(0) @map("expected_revenue_toman") @db.Decimal(18, 0)
  expectedWeightKg     Decimal   @default(0) @map("expected_weight_kg") @db.Decimal(18, 3)
  probability          Int       @default(20)
  salespersonId        String?   @map("salesperson_id") @db.Uuid
  salespersonName      String?   @map("salesperson_name")
  lostReasonId         String?   @map("lost_reason_id") @db.Uuid
  lostNotes            String?   @map("lost_notes")
  saleOrderId          String?   @map("sale_order_id") @db.Uuid
  tags                 Json      @default("[]")
  notes                String?
  closeDate            DateTime? @map("close_date") @db.Timestamptz(3)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt            DateTime? @map("deleted_at") @db.Timestamptz(3)

  contact   Contact?    @relation(fields: [contactId], references: [id])
  saleOrder SaleOrder?  @relation(fields: [saleOrderId], references: [id])

  @@index([stage, createdAt(sort: Desc)])
  @@index([contactId])
  @@index([salespersonId])
  @@map("crm_leads")
}

model DailyPrice {
  id               String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  date             DateTime            @db.Date
  productId        String?             @map("product_id") @db.Uuid
  productName      String              @map("product_name")
  category         ProductCategoryType @default(REBAR)
  mill             String              @default("")
  size             String              @default("")
  standard         String              @default("")
  unit             String              @default("کیلوگرم")
  priceToman       Decimal             @map("price_toman") @db.Decimal(18, 0)
  prevPriceToman   Decimal?            @map("prev_price_toman") @db.Decimal(18, 0)
  priceChangeToman Decimal?            @map("price_change_toman") @db.Decimal(18, 0)
  published        Boolean             @default(true)
  announcedAt      DateTime            @default(now()) @map("announced_at") @db.Timestamptz(3)
  notes            String?
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  product Product? @relation(fields: [productId], references: [id])

  @@index([date(sort: Desc), category])
  @@index([mill])
  @@map("daily_prices")
}

// ───────────── Weighbridge (قبوض باسکول آهن‌آلات) ─────────────

model WeighbridgeSlip {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slipNo       String    @unique @map("slip_no") // WB-1403-XXXX
  saleOrderId  String?   @map("sale_order_id") @db.Uuid
  customerId   String?   @map("customer_id") @db.Uuid
  customerName String    @map("customer_name")
  netWeightKg  Decimal   @map("net_weight_kg") @db.Decimal(18, 3)
  vehiclePlate String    @map("vehicle_plate")
  waybillNo    String?   @map("waybill_no")
  driverName   String?   @map("driver_name")
  driverMobile String?   @map("driver_mobile")
  scaleName    String?   @map("scale_name")
  operatorName String?   @map("operator_name")
  weighedAt    DateTime  @default(now()) @map("weighed_at") @db.Timestamptz(3)
  notes        String?
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(3)

  saleOrder SaleOrder? @relation(fields: [saleOrderId], references: [id], onDelete: SetNull)
  customer  Contact?   @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([saleOrderId])
  @@index([customerId])
  @@index([weighedAt(sort: Desc)])
  @@index([vehiclePlate])
  @@map("weighbridge_slips")
}



